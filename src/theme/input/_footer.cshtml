<footer>
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center">

                @if (Document.ContainsKey("Canonical"))
                {
                    <p class="text-center small text-muted">
                        Originally published at
                        <a href='@Document.GetString("Canonical")'>
                            @Document.GetString("Canonical")
                        </a>.
                    </p>
                    <br />
                }

                @Html.Partial("_copyright")

                <ul class="list-inline text-center small" style="margin-top: 15px;">

                    <!-- Dot4 사이트 -->
                    <li class="list-inline-item mb-2">
                        <a class="btn btn-outline-primary btn-sm px-3 py-2 shadow-sm"
                           style="border-radius: 30px;"
                           href="https://dot4.kr/" target="_blank">
                            <i class="fa fa-home mr-1"></i> Dot4 사이트
                        </a>
                    </li>

                    <!-- Discord -->
                    <li class="list-inline-item mb-2">
                        <a class="btn btn-outline-info btn-sm px-3 py-2 shadow-sm"
                           style="border-radius: 30px;"
                           href="https://discord.com/invite/uQjHqcGtUJ" target="_blank">
                            <i class="fa fa-comments mr-1"></i> 디스코드 입장
                        </a>
                    </li>

                    <!-- KakaoTalk -->
                    <li class="list-inline-item mb-2">
                        <a class="btn btn-outline-warning btn-sm px-3 py-2 shadow-sm"
                           style="border-radius: 30px;"
                           href="https://open.kakao.com/o/gaXg2I5g" target="_blank">
                            <i class="fa fa-commenting mr-1"></i> 카카오톡 오픈채팅
                        </a>
                    </li>

                </ul>

                <br />

                <div class="font-weight-bold small">
                    <a href="https://statiq.dev">Generated by Statiq</a>
                </div>

            </div>
        </div>
    </div>
</footer>
